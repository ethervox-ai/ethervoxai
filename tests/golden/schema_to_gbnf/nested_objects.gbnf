root-user-value-name-value ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" ["\\/bfnrt])* "\"" ws
root-user-value-age-value ::= ("-")? [0-9]+
root-user-value-address-value-street-value ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" ["\\/bfnrt])* "\"" ws
root-user-value-address-value-city-value ::= "\"" ([^"\\\x7F\x00-\x1F] | "\\" ["\\/bfnrt])* "\"" ws
root-user-value-address-value ::= "{" ws "\"street\"" ws ":" ws root-user-value-address-value-street-value ws "," ws "\"city\"" ws ":" ws root-user-value-address-value-city-value ws "}" ws
root-user-value ::= "{" ws "\"name\"" ws ":" ws root-user-value-name-value ws "," ws "\"age\"" ws ":" ws root-user-value-age-value ws "," ws "\"address\"" ws ":" ws root-user-value-address-value ws "}" ws
root-timestamp-value ::= ("-")? [0-9]+
root ::= "{" ws "\"user\"" ws ":" ws root-user-value ws "," ws "\"timestamp\"" ws ":" ws root-timestamp-value ws "}" ws
ws ::= | " " | "\n" [ \t]{0,20}
